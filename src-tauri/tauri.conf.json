{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Analyzer",
  "version": "0.1.0",
  "identifier": "com.diskanalyzer.app",
  "build": {
    "beforeDevCommand": "ng serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "ng build",
    "frontendDist": "../dist/disk-analyzer/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Disk Analyzer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.ico",
      "icons/48x48.ico",
      "icons/64x64.ico",
      "icons/128x128.ico",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
